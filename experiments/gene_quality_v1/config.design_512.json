      "winner_additional_updates_max": 6000
    },
    "gene_distill": {
      "variants": [
        "random_s8",
        "learned_s8",
        "learned_s4"
      ],
      "max_updates_each": 2000,
      "renderer_frozen": true,
      "loss": "normalized_condition_mse",
      "dictionary_initialization": "paired identical normalized random seed; learnable versus frozen"
    },
    "gene_finetune": {
      "max_updates_each": 8000,
      "loss": "denoise_loss + 0.1 * normalized_condition_mse",
      "coefficient_and_dictionary_updates": "only allowed parameters per variant",
      "adapter_initialized_from_dense_winner": true,
      "teacher_frozen": true,
      "no_edit_loss": true,
      "variants": [
        "dense_plus",
        "random_s8",
        "learned_s8",
        "learned_s4"
      ],
      "freeze_input_fusion": true,
      "dense_plus_reference_updates": 8000,
      "teacher_normalizer": {
        "statistic": "training mean squared dense feature value",
        "frozen_after_training_split_estimate": true,
        "epsilon": 1e-06
      },
      "dictionary_init_seed": 17
    },
    "final_seed_replication": {
      "train_seeds": [
        17,
        29,
        43
      ],
      "models": [
        "selected_dense",
        "selected_gene"
      ],
