      "grid": [
        64,
        64
      ],
      "channels": 4,
      "fusion_grid": [
        16,
        16
      ]
    },
    "gene": {
      "bank_size": 512,
      "dimension": 256,
      "coefficient": "signed top-k by absolute magnitude; retained coefficients continuous",
      "normalize_dictionary_columns": true,
      "residual_bypass": false
